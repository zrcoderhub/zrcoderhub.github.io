---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="体力计算器" description="绝区零体力电量回复计算器">
  <h1 class="page-title">🔋 体力计算器</h1>
  <p class="page-desc">电量回复时间计算 · 每日规划 · 咖啡使用策略</p>

  <div class="grid-2">
    <!-- Recovery Calculator -->
    <div class="card" style="text-align:center;">
      <h3 style="margin-bottom:16px;">⏱️ 回复倒计时</h3>
      <div style="font-size:0.9rem;color:var(--text-dim);margin-bottom:8px;">当前电量</div>
      <input type="number" id="current-stamina" min="0" max="240" value="0" class="search-input" style="text-align:center;font-size:1.5rem;width:120px;margin:0 auto;" />
      <input type="range" id="stamina-slider" min="0" max="240" value="0" style="width:100%;margin:12px 0;" />
      <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--text-dim);margin-top:-8px;">
        <span>0</span><span>60</span><span>120</span><span>180</span><span>240</span>
      </div>
      <div style="margin-top:16px;padding:16px;background:var(--bg);border-radius:var(--radius);">
        <div style="font-size:0.85rem;color:var(--text-dim);">预计回满时间</div>
        <div style="font-size:2rem;font-weight:700;color:var(--accent);" id="recovery-time">--:--:--</div>
        <div style="font-size:0.8rem;color:var(--text-dim);" id="recovery-date"></div>
      </div>
      <div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <div style="padding:8px;background:var(--bg);border-radius:var(--radius);">
          <div style="font-size:0.75rem;color:var(--text-dim);">还需回复</div>
          <div style="font-weight:700;" id="need-recover">240</div>
        </div>
        <div style="padding:8px;background:var(--bg);border-radius:var(--radius);">
          <div style="font-size:0.75rem;color:var(--text-dim);">恢复速度</div>
          <div style="font-weight:700;">6分钟/点</div>
        </div>
      </div>
    </div>

    <!-- Daily Planning -->
    <div class="card">
      <h3 style="margin-bottom:16px;">📋 每日体力规划</h3>
      <table class="info-table">
        <tr><th>自然恢复</th><td>每6分钟1点 → 240点/天</td></tr>
        <tr><th>咖啡店</th><td>+60点（每日免费1次）</td></tr>
        <tr><th>菲林购买</th><td>50/75/100/125/150/200 (逐次递增，每日限6次)</td></tr>
        <tr><th>每日上限</th><td>约300点（自然+咖啡）</td></tr>
        <tr><th>以太电池</th><td>+60点（活动奖励，不设上限）</td></tr>
      </table>

      <h4 style="margin-top:16px;margin-bottom:8px;color:var(--accent2);">📊 体力消耗优先级</h4>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div style="display:flex;align-items:center;gap:8px;padding:8px;background:rgba(255,215,0,0.1);border-radius:4px;">
          <span style="font-size:1.2rem;">🥇</span>
          <div><strong>基础材料</strong><span style="font-size:0.8rem;color:var(--text-dim);display:block;">角色/武器突破必需品，永远缺</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;padding:8px;background:rgba(170,170,170,0.1);border-radius:4px;">
          <span style="font-size:1.2rem;">🥈</span>
          <div><strong>代理人晋升</strong><span style="font-size:0.8rem;color:var(--text-dim);display:block;">提升等级上限、解锁天赋</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;padding:8px;background:rgba(205,127,50,0.1);border-radius:4px;">
          <span style="font-size:1.2rem;">🥉</span>
          <div><strong>代理人技能</strong><span style="font-size:0.8rem;color:var(--text-dim);display:block;">提升技能倍率，稳定提升</span></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;padding:8px;background:rgba(136,136,170,0.1);border-radius:4px;">
          <span style="font-size:1.2rem;">4️⃣</span>
          <div><strong>驱动盘</strong><span style="font-size:0.8rem;color:var(--text-dim);display:block;">42级后稳定出S级再刷</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Level Planning -->
  <div class="card" style="margin-top:16px;">
    <h3 style="margin-bottom:12px;">📈 绳匠等级经验</h3>
    <table class="info-table">
      <tr><th>经验获取</th><td>每消耗10点电量 = 50绳匠经验</td></tr>
      <tr><th>每日经验</th><td>约1500经验（300电量）</td></tr>
      <tr><th>1-40级</th><td>跟随主线即可，无需刻意刷</td></tr>
      <tr><th>40-50级</th><td>约需2-3周日常体力</td></tr>
      <tr><th>50-60级</th><td>约需4-6周日常体力</td></tr>
    </table>
  </div>
</BaseLayout>

<script>
  const RECOVERY_MINUTES = 6; // 6 min per stamina point
  const MAX_STAMINA = 240;

  function update() {
    const current = parseInt(document.getElementById('current-stamina').value) || 0;
    const need = MAX_STAMINA - current;
    const minutes = need * RECOVERY_MINUTES;
    const now = new Date();
    const fullTime = new Date(now.getTime() + minutes * 60000);

    const h = Math.floor(minutes / 60);
    const m = minutes % 60;

    document.getElementById('recovery-time').textContent =
      minutes === 0 ? '已满！' : `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:00`;
    document.getElementById('recovery-date').textContent =
      minutes === 0 ? '' : `预计 ${fullTime.getHours().toString().padStart(2,'0')}:${fullTime.getMinutes().toString().padStart(2,'0')}`;
    document.getElementById('need-recover').textContent = need;
    document.getElementById('stamina-slider').value = current;
  }

  document.getElementById('current-stamina').addEventListener('input', update);
  document.getElementById('stamina-slider').addEventListener('input', function() {
    document.getElementById('current-stamina').value = this.value;
    update();
  });
  update();
</script>
